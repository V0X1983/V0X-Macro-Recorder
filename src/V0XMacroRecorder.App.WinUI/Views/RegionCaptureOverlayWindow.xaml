<?xml version="1.0" encoding="utf-8" ?>
<Window
    x:Class="V0XMacroRecorder.App.Views.RegionCaptureOverlayWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid x:Name="RootGrid" Background="Black"
          IsTabStop="True"
          PointerPressed="RootGrid_PointerPressed" PointerMoved="RootGrid_PointerMoved"
          PointerReleased="RootGrid_PointerReleased" KeyDown="RootGrid_KeyDown">

        <!-- Capture figée du bureau (voir ScreenSnapshot) : une Window WinUI 3 ne peut pas laisser voir le vrai bureau au travers d'elle comme le faisait la version WPF transparente. -->
        <Image x:Name="BackgroundImage" Stretch="Fill" IsHitTestVisible="False" />

        <Rectangle x:Name="TintRectangle" Fill="#40000000" IsHitTestVisible="False" />

        <TextBlock x:Name="InstructionBanner" Text="Glissez pour sélectionner une région — Échap pour annuler"
                   Foreground="White" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Top"
                   Margin="0,24,0,0" IsHitTestVisible="False" />

        <Border x:Name="SelectionBorder" BorderBrush="#FF3399FF" BorderThickness="2" Background="#203399FF"
                HorizontalAlignment="Left" VerticalAlignment="Top" Visibility="Collapsed" IsHitTestVisible="False" />
    </Grid>
</Window>
