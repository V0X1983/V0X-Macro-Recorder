<?xml version="1.0" encoding="utf-8" ?>
<Window
    x:Class="V0XMacroRecorder.App.Views.ColorPickerOverlayWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid x:Name="RootGrid" Background="Black" IsTabStop="True"
          PointerMoved="RootGrid_PointerMoved" PointerPressed="RootGrid_PointerPressed" KeyDown="RootGrid_KeyDown">
        <!-- Capture figée du bureau (voir ScreenSnapshot) : voir le commentaire équivalent dans RegionCaptureOverlayWindow.xaml. -->
        <Image x:Name="BackgroundImage" Stretch="Fill" IsHitTestVisible="False" />
        <StackPanel x:Name="PreviewPanel" Orientation="Horizontal" Spacing="8"
                    HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False">
            <Border x:Name="PreviewSwatch" Width="24" Height="24" BorderBrush="White" BorderThickness="2" />
            <TextBlock x:Name="PreviewLabel" Foreground="White" FontSize="16" FontFamily="Consolas" VerticalAlignment="Center" />
        </StackPanel>
    </Grid>
</Window>
