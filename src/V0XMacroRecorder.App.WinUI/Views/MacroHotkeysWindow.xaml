<?xml version="1.0" encoding="utf-8" ?>
<Window
    x:Class="V0XMacroRecorder.App.Views.MacroHotkeysWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="using:V0XMacroRecorder.App.ViewModels"
    xmlns:helpers="using:V0XMacroRecorder.App.Helpers"
    mc:Ignorable="d">

    <StackPanel x:Name="RootPanel" Margin="20" MaxWidth="520">
        <StackPanel.Resources>
            <helpers:BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
            <helpers:NullOrEmptyToVisibilityConverter x:Key="NullOrEmptyToVisibilityConverter" />
        </StackPanel.Resources>

        <TextBlock Text="Lancer une macro depuis n'importe où : chaque ligne associe un fichier macro à un raccourci global."
                   TextWrapping="Wrap" Margin="0,0,0,12" />

        <ScrollViewer MaxHeight="320" VerticalScrollBarVisibility="Auto">
            <ItemsControl ItemsSource="{Binding Rows}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:MacroHotkeyRowViewModel">
                        <Border BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="0,0,0,1" Padding="0,8">
                            <StackPanel>
                                <Grid ColumnDefinitions="*,Auto">
                                    <TextBlock Grid.Column="0" Text="{x:Bind FileName}" ToolTipService.ToolTip="{x:Bind MacroFilePath}" FontWeight="SemiBold" VerticalAlignment="Center" />
                                    <Button Grid.Column="1" Content="Supprimer" Margin="8,0,0,0"
                                            Command="{Binding DataContext.RemoveRowCommand, ElementName=RootPanel}"
                                            CommandParameter="{Binding}" />
                                </Grid>
                                <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                    <CheckBox Content="Ctrl" IsChecked="{x:Bind Ctrl, Mode=TwoWay}" Margin="0,0,10,0" />
                                    <CheckBox Content="Alt" IsChecked="{x:Bind Alt, Mode=TwoWay}" Margin="0,0,10,0" />
                                    <CheckBox Content="Maj" IsChecked="{x:Bind Shift, Mode=TwoWay}" Margin="0,0,10,0" />
                                    <CheckBox Content="Win" IsChecked="{x:Bind Win, Mode=TwoWay}" />
                                </StackPanel>
                                <TextBox Tag="MacroHotkeyCapture" IsReadOnly="True" HorizontalAlignment="Left"
                                         Text="{x:Bind KeyLabel, Mode=OneWay}" FontWeight="SemiBold" MinWidth="200" Margin="0,6,0,0" />
                                <TextBlock Text="Raccourci déjà utilisé par une autre application." Foreground="{ThemeResource SystemFillColorCautionBrush}"
                                           Margin="0,4,0,0" Visibility="{Binding HasConflict, Converter={StaticResource BooleanToVisibilityConverter}}" />
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <Button Content="Ajouter une macro…" Command="{Binding AddMacroCommand}" HorizontalAlignment="Left" Margin="0,12,0,0" />

        <TextBlock Text="{Binding StatusMessage}" TextWrapping="Wrap" Margin="0,12,0,0"
                   Visibility="{Binding StatusMessage, Converter={StaticResource NullOrEmptyToVisibilityConverter}}" />

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
            <Button Content="Enregistrer" MinWidth="90" Style="{StaticResource AccentButtonStyle}" Click="SaveButton_Click" />
            <Button Content="Fermer" MinWidth="90" Margin="8,0,0,0" Click="CloseButton_Click" />
        </StackPanel>
    </StackPanel>
</Window>
