<?xml version="1.0" encoding="utf-8" ?>
<Window
    x:Class="V0XMacroRecorder.App.Views.MacroScheduleWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="using:V0XMacroRecorder.App.ViewModels"
    xmlns:helpers="using:V0XMacroRecorder.App.Helpers"
    mc:Ignorable="d">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
    <StackPanel x:Name="RootPanel" Margin="20" MaxWidth="520">
        <StackPanel.Resources>
            <helpers:BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
            <helpers:NullOrEmptyToVisibilityConverter x:Key="NullOrEmptyToVisibilityConverter" />
            <DataTemplate x:Key="ChoiceTemplate">
                <TextBlock Text="{Binding Label}" />
            </DataTemplate>
        </StackPanel.Resources>

        <TextBlock Text="Macros déjà planifiées" FontWeight="SemiBold" Margin="0,0,0,8" />
        <ItemsControl ItemsSource="{Binding Rows}">
            <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:ScheduledMacroRowViewModel">
                    <Border BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="0,0,0,1" Padding="0,6">
                        <Grid ColumnDefinitions="*,Auto">
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="{x:Bind TaskName}" FontWeight="SemiBold" />
                                <TextBlock Text="{x:Bind MacroFilePath}" TextWrapping="Wrap" FontSize="11" Opacity="0.8" />
                            </StackPanel>
                            <Button Grid.Column="1" Content="Supprimer" Margin="8,0,0,0" VerticalAlignment="Top"
                                    Command="{Binding DataContext.RemoveCommand, ElementName=RootPanel}"
                                    CommandParameter="{Binding}" />
                        </Grid>
                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <TextBlock Text="Ajouter une planification" FontWeight="SemiBold" Margin="0,20,0,8" />

        <TextBlock Text="Fichier macro (.v0xmacro)" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
        <Grid Margin="0,0,0,8" ColumnDefinitions="*,Auto">
            <TextBox Grid.Column="0" Text="{Binding NewMacroFilePath, Mode=OneWay}" IsReadOnly="True" />
            <Button Grid.Column="1" Content="Parcourir…" Command="{Binding BrowseMacroCommand}" Margin="6,0,0,0" />
        </Grid>

        <TextBlock Text="Déclencheur" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
        <ComboBox ItemsSource="{Binding KindChoicesInstance}" ItemTemplate="{StaticResource ChoiceTemplate}"
                  SelectedValuePath="Value" SelectedValue="{Binding NewKind, Mode=TwoWay}" Margin="0,0,0,8" HorizontalAlignment="Stretch" />

        <StackPanel Visibility="{Binding ShowsTime, Converter={StaticResource BooleanToVisibilityConverter}}">
            <TextBlock Text="Heure (HH:mm)" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            <TextBox Text="{Binding NewTimeText, Mode=TwoWay}" Margin="0,0,0,8" />
        </StackPanel>

        <StackPanel Visibility="{Binding ShowsDay, Converter={StaticResource BooleanToVisibilityConverter}}">
            <TextBlock Text="Jour" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            <ComboBox ItemsSource="{Binding DayChoicesInstance}" ItemTemplate="{StaticResource ChoiceTemplate}"
                      SelectedValuePath="Value" SelectedValue="{Binding NewDayOfWeek, Mode=TwoWay}" Margin="0,0,0,8" HorizontalAlignment="Stretch" />
        </StackPanel>

        <StackPanel Visibility="{Binding ShowsInterval, Converter={StaticResource BooleanToVisibilityConverter}}">
            <TextBlock Text="Toutes les (minutes)" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            <TextBox Text="{Binding NewIntervalMinutesText, Mode=TwoWay}" Margin="0,0,0,8" />
        </StackPanel>

        <TextBlock Text="Répétitions par déclenchement (1 = comportement normal de la macro)" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
        <TextBox Text="{Binding NewRepeatCountText, Mode=TwoWay}" Margin="0,0,0,8" />

        <Button Content="Ajouter" Command="{Binding AddCommand}" HorizontalAlignment="Left" Style="{StaticResource AccentButtonStyle}" />

        <TextBlock Text="{Binding StatusMessage}" TextWrapping="Wrap" Margin="0,12,0,0"
                   Visibility="{Binding StatusMessage, Converter={StaticResource NullOrEmptyToVisibilityConverter}}" />

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
            <Button Content="Fermer" MinWidth="90" Click="CloseButton_Click" />
        </StackPanel>
    </StackPanel>
    </ScrollViewer>
</Window>
