<?xml version="1.0" encoding="utf-8"?>
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
        Palette V0X (portée de src/V0XMacroRecorder.App/Resources/Themes/{Dark,Light}.xaml, valeurs identiques).
        Contrairement à WPF (deux fichiers échangés à la main par ThemeManager), WinUI 3 bascule automatiquement
        entre les deux branches ci-dessous via ResourceDictionary.ThemeDictionaries dès que RequestedTheme change
        sur la racine visuelle (déjà posé par Helpers/ThemeManager.cs) — aucun code de bascule supplémentaire requis.
    -->
    <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Dark">
            <Color x:Key="ColorBackground">#FF141821</Color>
            <Color x:Key="ColorSurface">#FF1C2130</Color>
            <Color x:Key="ColorSurfaceAlt">#FF232939</Color>
            <Color x:Key="ColorBorder">#FF2E3646</Color>
            <Color x:Key="ColorAccent">#FF3DDC97</Color>
            <Color x:Key="ColorAccentHover">#FF33C287</Color>
            <Color x:Key="ColorTextPrimary">#FFEAECEF</Color>
            <Color x:Key="ColorTextSecondary">#FF9AA4B2</Color>
            <Color x:Key="ColorDanger">#FFE0555A</Color>
            <Color x:Key="ColorWarning">#FFE0A73D</Color>
            <Color x:Key="ColorRecord">#FFFF5A45</Color>

            <SolidColorBrush x:Key="BrushBackground" Color="{StaticResource ColorBackground}" />
            <SolidColorBrush x:Key="BrushSurface" Color="{StaticResource ColorSurface}" />
            <SolidColorBrush x:Key="BrushSurfaceAlt" Color="{StaticResource ColorSurfaceAlt}" />
            <SolidColorBrush x:Key="BrushBorder" Color="{StaticResource ColorBorder}" />
            <SolidColorBrush x:Key="BrushAccent" Color="{StaticResource ColorAccent}" />
            <SolidColorBrush x:Key="BrushAccentHover" Color="{StaticResource ColorAccentHover}" />
            <SolidColorBrush x:Key="BrushTextPrimary" Color="{StaticResource ColorTextPrimary}" />
            <SolidColorBrush x:Key="BrushTextSecondary" Color="{StaticResource ColorTextSecondary}" />
            <SolidColorBrush x:Key="BrushDanger" Color="{StaticResource ColorDanger}" />
            <SolidColorBrush x:Key="BrushWarning" Color="{StaticResource ColorWarning}" />
            <SolidColorBrush x:Key="BrushRecord" Color="{StaticResource ColorRecord}" />
        </ResourceDictionary>

        <ResourceDictionary x:Key="Light">
            <Color x:Key="ColorBackground">#FFF5F6F8</Color>
            <Color x:Key="ColorSurface">#FFFFFFFF</Color>
            <Color x:Key="ColorSurfaceAlt">#FFEBEDF0</Color>
            <Color x:Key="ColorBorder">#FFD8DCE2</Color>
            <Color x:Key="ColorAccent">#FF1F9D6B</Color>
            <Color x:Key="ColorAccentHover">#FF188056</Color>
            <Color x:Key="ColorTextPrimary">#FF1B1F27</Color>
            <Color x:Key="ColorTextSecondary">#FF5B6472</Color>
            <Color x:Key="ColorDanger">#FFC63B40</Color>
            <!-- Assombri comme côté WPF (accessibilité, étape 7) : #FFAD7A16 ne donnait que 3,77:1 sur blanc pour du
                 texte, sous le seuil WCAG AA 4,5:1. #FF96600F -> 5,28:1. -->
            <Color x:Key="ColorWarning">#FF96600F</Color>
            <Color x:Key="ColorRecord">#FFE5381F</Color>

            <SolidColorBrush x:Key="BrushBackground" Color="{StaticResource ColorBackground}" />
            <SolidColorBrush x:Key="BrushSurface" Color="{StaticResource ColorSurface}" />
            <SolidColorBrush x:Key="BrushSurfaceAlt" Color="{StaticResource ColorSurfaceAlt}" />
            <SolidColorBrush x:Key="BrushBorder" Color="{StaticResource ColorBorder}" />
            <SolidColorBrush x:Key="BrushAccent" Color="{StaticResource ColorAccent}" />
            <SolidColorBrush x:Key="BrushAccentHover" Color="{StaticResource ColorAccentHover}" />
            <SolidColorBrush x:Key="BrushTextPrimary" Color="{StaticResource ColorTextPrimary}" />
            <SolidColorBrush x:Key="BrushTextSecondary" Color="{StaticResource ColorTextSecondary}" />
            <SolidColorBrush x:Key="BrushDanger" Color="{StaticResource ColorDanger}" />
            <SolidColorBrush x:Key="BrushWarning" Color="{StaticResource ColorWarning}" />
            <SolidColorBrush x:Key="BrushRecord" Color="{StaticResource ColorRecord}" />
        </ResourceDictionary>
    </ResourceDictionary.ThemeDictionaries>

</ResourceDictionary>
