<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Palette claire V0X (identique à V0X Cleaner) + couleur d'enregistrement. -->
    <Color x:Key="ColorBackground">#FFF5F6F8</Color>
    <Color x:Key="ColorSurface">#FFFFFFFF</Color>
    <Color x:Key="ColorSurfaceAlt">#FFEBEDF0</Color>
    <Color x:Key="ColorBorder">#FFD8DCE2</Color>
    <Color x:Key="ColorAccent">#FF1F9D6B</Color>
    <Color x:Key="ColorAccentHover">#FF188056</Color>
    <Color x:Key="ColorTextPrimary">#FF1B1F27</Color>
    <Color x:Key="ColorTextSecondary">#FF5B6472</Color>
    <Color x:Key="ColorDanger">#FFC63B40</Color>
    <!-- Assombri à l'étape 7 (accessibilité) : #FFAD7A16 ne donnait que 3,77:1 sur blanc pour du texte (avertissements/sécurité), sous le seuil WCAG AA 4,5:1. #FF96600F -> 5,28:1. -->
    <Color x:Key="ColorWarning">#FF96600F</Color>
    <Color x:Key="ColorRecord">#FFE5381F</Color>

    <SolidColorBrush x:Key="BrushBackground" Color="{StaticResource ColorBackground}" />
    <SolidColorBrush x:Key="BrushSurface" Color="{StaticResource ColorSurface}" />
    <SolidColorBrush x:Key="BrushSurfaceAlt" Color="{StaticResource ColorSurfaceAlt}" />
    <SolidColorBrush x:Key="BrushBorder" Color="{StaticResource ColorBorder}" />
    <SolidColorBrush x:Key="BrushAccent" Color="{StaticResource ColorAccent}" />
    <SolidColorBrush x:Key="BrushAccentHover" Color="{StaticResource ColorAccentHover}" />
    <SolidColorBrush x:Key="BrushTextPrimary" Color="{StaticResource ColorTextPrimary}" />
    <SolidColorBrush x:Key="BrushTextSecondary" Color="{StaticResource ColorTextSecondary}" />
    <SolidColorBrush x:Key="BrushDanger" Color="{StaticResource ColorDanger}" />
    <SolidColorBrush x:Key="BrushWarning" Color="{StaticResource ColorWarning}" />
    <SolidColorBrush x:Key="BrushRecord" Color="{StaticResource ColorRecord}" />

</ResourceDictionary>
