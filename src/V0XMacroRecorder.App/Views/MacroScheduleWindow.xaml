<Window x:Class="V0XMacroRecorder.App.Views.MacroScheduleWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:V0XMacroRecorder.App.ViewModels"
        Style="{StaticResource {x:Type Window}}"
        Title="Planifier une macro" Icon="../Resources/app.ico"
        Width="520" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">

    <Window.Resources>
        <DataTemplate x:Key="ChoiceTemplate">
            <TextBlock Text="{Binding Label}" />
        </DataTemplate>
        <Style TargetType="ComboBox" BasedOn="{StaticResource {x:Type ComboBox}}">
            <Setter Property="ItemTemplate" Value="{StaticResource ChoiceTemplate}" />
        </Style>
    </Window.Resources>

    <StackPanel Margin="20">
        <TextBlock Text="Macros déjà planifiées" FontWeight="SemiBold" Margin="0,0,0,8" />
        <ItemsControl ItemsSource="{Binding Rows}">
            <ItemsControl.ItemTemplate>
                <DataTemplate DataType="{x:Type vm:ScheduledMacroRowViewModel}">
                    <Border BorderBrush="{DynamicResource BrushBorder}" BorderThickness="0,0,0,1" Padding="0,6">
                        <DockPanel>
                            <Button DockPanel.Dock="Right" Content="Supprimer" Margin="8,0,0,0"
                                    Command="{Binding DataContext.RemoveCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                    CommandParameter="{Binding}" />
                            <StackPanel>
                                <TextBlock Text="{Binding TaskName}" FontWeight="SemiBold" />
                                <TextBlock Text="{Binding MacroFilePath}" TextWrapping="Wrap" FontSize="11" Opacity="0.8" />
                            </StackPanel>
                        </DockPanel>
                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <TextBlock Text="Ajouter une planification" FontWeight="SemiBold" Margin="0,20,0,8" />

        <TextBlock Text="Fichier macro (.v0xmacro)" Style="{StaticResource FieldLabelStyle}" />
        <DockPanel Margin="0,0,0,8">
            <Button DockPanel.Dock="Right" Content="Parcourir…" Command="{Binding BrowseMacroCommand}" Margin="6,0,0,0" />
            <TextBox Text="{Binding NewMacroFilePath, Mode=OneWay}" IsReadOnly="True" />
        </DockPanel>

        <TextBlock Text="Déclencheur" Style="{StaticResource FieldLabelStyle}" />
        <ComboBox ItemsSource="{x:Static vm:MacroScheduleViewModel.KindChoices}"
                  SelectedValuePath="Value" SelectedValue="{Binding NewKind}" Margin="0,0,0,8" />

        <StackPanel Visibility="{Binding ShowsTime, Converter={StaticResource BooleanToVisibilityConverter}}">
            <TextBlock Text="Heure (HH:mm)" Style="{StaticResource FieldLabelStyle}" />
            <TextBox Text="{Binding NewTimeText, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,8" />
        </StackPanel>

        <StackPanel Visibility="{Binding ShowsDay, Converter={StaticResource BooleanToVisibilityConverter}}">
            <TextBlock Text="Jour" Style="{StaticResource FieldLabelStyle}" />
            <ComboBox ItemsSource="{x:Static vm:MacroScheduleViewModel.DayChoices}"
                      SelectedValuePath="Value" SelectedValue="{Binding NewDayOfWeek}" Margin="0,0,0,8" />
        </StackPanel>

        <StackPanel Visibility="{Binding ShowsInterval, Converter={StaticResource BooleanToVisibilityConverter}}">
            <TextBlock Text="Toutes les (minutes)" Style="{StaticResource FieldLabelStyle}" />
            <TextBox Text="{Binding NewIntervalMinutesText, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,8" />
        </StackPanel>

        <TextBlock Text="Répétitions par déclenchement (1 = comportement normal de la macro)" Style="{StaticResource FieldLabelStyle}" TextWrapping="Wrap" />
        <TextBox Text="{Binding NewRepeatCountText, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,8" />

        <Button Content="Ajouter" Command="{Binding AddCommand}" HorizontalAlignment="Left" Style="{StaticResource PrimaryButtonStyle}" />

        <TextBlock Text="{Binding StatusMessage}" TextWrapping="Wrap" Margin="0,12,0,0"
                   Visibility="{Binding StatusMessage, Converter={StaticResource NullOrEmptyToVisibilityConverter}}" />

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
            <Button Content="Fermer" IsCancel="True" IsDefault="True" MinWidth="90" />
        </StackPanel>
    </StackPanel>
</Window>
