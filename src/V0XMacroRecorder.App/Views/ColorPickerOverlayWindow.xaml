<Window x:Class="V0XMacroRecorder.App.Views.ColorPickerOverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Choisir une couleur à l'écran"
        WindowStyle="None" AllowsTransparency="True" Background="#01000000"
        Topmost="True" ShowInTaskbar="False" ResizeMode="NoResize"
        Cursor="Cross"
        MouseMove="Window_MouseMove" MouseLeftButtonDown="Window_MouseLeftButtonDown"
        KeyDown="Window_KeyDown" Loaded="Window_Loaded">
    <Border Background="#CC202020" CornerRadius="6" Padding="12"
            HorizontalAlignment="Left" VerticalAlignment="Top" Margin="20">
        <StackPanel Orientation="Horizontal">
            <Rectangle x:Name="PreviewSwatch" Width="28" Height="28" Stroke="White" StrokeThickness="1" Margin="0,0,10,0" />
            <StackPanel>
                <TextBlock x:Name="PreviewLabel" Text="#000000  (0, 0)" Foreground="White" FontFamily="Consolas" FontSize="14" />
                <TextBlock Text="Cliquez pour choisir ce pixel — Échap pour annuler" Foreground="#CCCCCC" FontSize="11" Margin="0,4,0,0" />
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
