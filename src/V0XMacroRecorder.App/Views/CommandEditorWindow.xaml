<Window x:Class="V0XMacroRecorder.App.Views.CommandEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ed="clr-namespace:V0XMacroRecorder.App.ViewModels.Editors"
        xmlns:helpers="clr-namespace:V0XMacroRecorder.App.Helpers"
        xmlns:avalonEdit="http://icsharpcode.net/sharpdevelop/avalonedit"
        Style="{StaticResource {x:Type Window}}"
        Title="{Binding Title}" Icon="../Resources/app.ico"
        Width="460" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">

    <Window.Resources>
        <!-- Les listes déroulantes affichent le libellé de chaque Choice (DisplayMemberPath n'est pas repris par notre modèle de ComboBox). -->
        <DataTemplate x:Key="ChoiceTemplate">
            <TextBlock Text="{Binding Label}" />
        </DataTemplate>
        <Style TargetType="ComboBox" BasedOn="{StaticResource {x:Type ComboBox}}">
            <Setter Property="ItemTemplate" Value="{StaticResource ChoiceTemplate}" />
        </Style>

        <!-- Souris -->
        <DataTemplate DataType="{x:Type ed:MouseCommandEditorViewModel}">
            <StackPanel>
                <TextBlock Text="Action" Style="{StaticResource FieldLabelStyle}" Margin="0,0,0,4" />
                <ComboBox ItemsSource="{x:Static ed:MouseCommandEditorViewModel.ActionChoices}"
                          SelectedValuePath="Value" SelectedValue="{Binding Action}" />

                <StackPanel Visibility="{Binding ShowsButton, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <TextBlock Text="Bouton" Style="{StaticResource FieldLabelStyle}" />
                    <ComboBox ItemsSource="{x:Static ed:MouseCommandEditorViewModel.ButtonChoices}"
                              SelectedValuePath="Value" SelectedValue="{Binding Button}" />
                </StackPanel>

                <StackPanel Visibility="{Binding ShowsPosition, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <TextBlock Text="Repère des coordonnées" Style="{StaticResource FieldLabelStyle}" />
                    <ComboBox ItemsSource="{x:Static ed:MouseCommandEditorViewModel.CoordinateModeChoices}"
                              SelectedValuePath="Value" SelectedValue="{Binding CoordinateMode}" />
                    <Grid Margin="0,12,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="12" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="X (pixels)" Style="{StaticResource FieldLabelStyle}" Margin="0,0,0,4" />
                            <TextBox Text="{Binding XText, UpdateSourceTrigger=PropertyChanged}" />
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Y (pixels)" Style="{StaticResource FieldLabelStyle}" Margin="0,0,0,4" />
                            <TextBox Text="{Binding YText, UpdateSourceTrigger=PropertyChanged}" />
                        </StackPanel>
                    </Grid>
                </StackPanel>

                <StackPanel Visibility="{Binding ShowsWheel, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <TextBlock Text="Crans de molette (positif = vers le haut, négatif = vers le bas)" Style="{StaticResource FieldLabelStyle}" />
                    <TextBox Text="{Binding WheelText, UpdateSourceTrigger=PropertyChanged}" />
                </StackPanel>
            </StackPanel>
        </DataTemplate>

        <!-- Clavier -->
        <DataTemplate DataType="{x:Type ed:KeyboardCommandEditorViewModel}">
            <StackPanel>
                <TextBlock Text="Action" Style="{StaticResource FieldLabelStyle}" Margin="0,0,0,4" />
                <ComboBox ItemsSource="{x:Static ed:KeyboardCommandEditorViewModel.ActionChoices}"
                          SelectedValuePath="Value" SelectedValue="{Binding Action}" />

                <TextBlock Text="Touche : cliquez dans le champ puis appuyez sur la touche voulue" Style="{StaticResource FieldLabelStyle}" />
                <TextBox Tag="KeyCapture" IsReadOnly="True" IsReadOnlyCaretVisible="False" Cursor="Arrow"
                         Text="{Binding KeyLabel, Mode=OneWay}" FontWeight="SemiBold" />

                <TextBlock Text="Modificateurs" Style="{StaticResource FieldLabelStyle}" />
                <WrapPanel>
                    <CheckBox Content="Ctrl" IsChecked="{Binding Ctrl}" Margin="0,0,16,0" />
                    <CheckBox Content="Alt" IsChecked="{Binding Alt}" Margin="0,0,16,0" />
                    <CheckBox Content="Maj" IsChecked="{Binding Shift}" Margin="0,0,16,0" />
                    <CheckBox Content="Win" IsChecked="{Binding Win}" />
                </WrapPanel>
            </StackPanel>
        </DataTemplate>

        <!-- Texte -->
        <DataTemplate DataType="{x:Type ed:TextCommandEditorViewModel}">
            <StackPanel>
                <TextBlock Text="Texte à saisir" Style="{StaticResource FieldLabelStyle}" Margin="0,0,0,4" />
                <TextBox Text="{Binding Text, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" TextWrapping="Wrap"
                         MinHeight="90" MaxHeight="200" VerticalScrollBarVisibility="Auto" VerticalContentAlignment="Top" />
                <TextBlock Text="Délai entre deux caractères (ms)" Style="{StaticResource FieldLabelStyle}" />
                <TextBox Text="{Binding CharacterDelayText, UpdateSourceTrigger=PropertyChanged}" />
                <CheckBox Content="Remplacer {date}, {clipboard} et {var:nom} avant la saisie" IsChecked="{Binding ExpandTokens}" Margin="0,10,0,0" />
            </StackPanel>
        </DataTemplate>

        <!-- Presse-papiers -->
        <DataTemplate DataType="{x:Type ed:ClipboardCommandEditorViewModel}">
            <StackPanel>
                <TextBlock Text="Action" Style="{StaticResource FieldLabelStyle}" Margin="0,0,0,4" />
                <ComboBox ItemsSource="{x:Static ed:ClipboardCommandEditorViewModel.ActionChoices}"
                          SelectedValuePath="Value" SelectedValue="{Binding Action}" />

                <StackPanel Visibility="{Binding ShowsText, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <TextBlock Text="Texte à copier (jetons {date}/{clipboard}/{var:nom} acceptés)" Style="{StaticResource FieldLabelStyle}" TextWrapping="Wrap" />
                    <TextBox Text="{Binding Text, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" TextWrapping="Wrap"
                             MinHeight="60" MaxHeight="160" VerticalScrollBarVisibility="Auto" VerticalContentAlignment="Top" />
                </StackPanel>

                <StackPanel Visibility="{Binding ShowsVariable, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <TextBlock Text="Nom de la variable" Style="{StaticResource FieldLabelStyle}" />
                    <TextBox Text="{Binding VariableName, UpdateSourceTrigger=PropertyChanged}" />
                </StackPanel>
            </StackPanel>
        </DataTemplate>

        <!-- Attente -->
        <DataTemplate DataType="{x:Type ed:WaitCommandEditorViewModel}">
            <StackPanel>
                <TextBlock Text="Nature de l'attente" Style="{StaticResource FieldLabelStyle}" Margin="0,0,0,4" />
                <ComboBox ItemsSource="{x:Static ed:WaitCommandEditorViewModel.ModeChoices}"
                          SelectedValuePath="Value" SelectedValue="{Binding Mode}" />

                <StackPanel Visibility="{Binding ShowsDuration, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <TextBlock Text="Durée d'attente (ms)" Style="{StaticResource FieldLabelStyle}" />
                    <TextBox Text="{Binding DurationText, UpdateSourceTrigger=PropertyChanged}" />
                    <TextBlock Text="Durée aléatoire supplémentaire (ms, 0 = attente fixe)" Style="{StaticResource FieldLabelStyle}" />
                    <TextBox Text="{Binding RandomExtraText, UpdateSourceTrigger=PropertyChanged}" />
                </StackPanel>

                <StackPanel Visibility="{Binding ShowsWindowFields, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <TextBlock Text="Titre de la fenêtre (partiel)" Style="{StaticResource FieldLabelStyle}" />
                    <TextBox Text="{Binding WindowTitle, UpdateSourceTrigger=PropertyChanged}" />
                    <TextBlock Text="Classe Win32 (optionnelle)" Style="{StaticResource FieldLabelStyle}" />
                    <TextBox Text="{Binding WindowClassName, UpdateSourceTrigger=PropertyChanged}" />
                </StackPanel>

                <StackPanel Visibility="{Binding ShowsKeyField, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <TextBlock Text="Touche : cliquez dans le champ puis appuyez sur la touche voulue (laisser « N'importe quelle touche » pour ne pas restreindre)" Style="{StaticResource FieldLabelStyle}" TextWrapping="Wrap" />
                    <TextBox Tag="WaitKeyCapture" IsReadOnly="True" IsReadOnlyCaretVisible="False" Cursor="Arrow"
                             Text="{Binding KeyLabel, Mode=OneWay}" FontWeight="SemiBold" />
                </StackPanel>

                <StackPanel Visibility="{Binding ShowsPixelFields, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <Grid Margin="0,0,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="12" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="X" Style="{StaticResource FieldLabelStyle}" />
                            <TextBox Text="{Binding PixelXText, UpdateSourceTrigger=PropertyChanged}" />
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Y" Style="{StaticResource FieldLabelStyle}" />
                            <TextBox Text="{Binding PixelYText, UpdateSourceTrigger=PropertyChanged}" />
                        </StackPanel>
                    </Grid>
                    <TextBlock Text="Couleur attendue (#RRGGBB)" Style="{StaticResource FieldLabelStyle}" />
                    <TextBox Text="{Binding PixelColorHex, UpdateSourceTrigger=PropertyChanged}" />
                    <Button Content="Choisir à l'écran (pipette)" Command="{Binding PickColorCommand}" Margin="0,6,0,0" HorizontalAlignment="Left" />
                    <TextBlock Text="Tolérance (%)" Style="{StaticResource FieldLabelStyle}" />
                    <TextBox Text="{Binding PixelToleranceText, UpdateSourceTrigger=PropertyChanged}" />
                </StackPanel>

                <StackPanel Visibility="{Binding ShowsImageFields, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <TextBlock Text="{Binding ImageTemplateSummary}" Style="{StaticResource FieldLabelStyle}" />
                    <Button Content="Capturer une image" Command="{Binding CaptureImageCommand}" Margin="0,4,0,0" HorizontalAlignment="Left" />
                    <TextBlock Text="Tolérance (%)" Style="{StaticResource FieldLabelStyle}" Margin="0,8,0,0" />
                    <TextBox Text="{Binding ImageToleranceText, UpdateSourceTrigger=PropertyChanged}" />
                </StackPanel>

                <StackPanel Visibility="{Binding ShowsTimeout, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <TextBlock Text="Délai d'attente maximal (ms)" Style="{StaticResource FieldLabelStyle}" />
                    <TextBox Text="{Binding TimeoutText, UpdateSourceTrigger=PropertyChanged}" />
                </StackPanel>
            </StackPanel>
        </DataTemplate>

        <!-- Programme / fichier -->
        <DataTemplate DataType="{x:Type ed:LaunchCommandEditorViewModel}">
            <StackPanel>
                <TextBlock Text="Nature" Style="{StaticResource FieldLabelStyle}" Margin="0,0,0,4" />
                <ComboBox ItemsSource="{x:Static ed:LaunchCommandEditorViewModel.ModeChoices}"
                          SelectedValuePath="Value" SelectedValue="{Binding Mode}" />

                <TextBlock Text="Chemin (programme ou commande)" Style="{StaticResource FieldLabelStyle}" />
                <TextBox Text="{Binding Path, UpdateSourceTrigger=PropertyChanged}" />

                <StackPanel Visibility="{Binding ShowsProgramFields, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <TextBlock Text="Arguments (optionnels)" Style="{StaticResource FieldLabelStyle}" />
                    <TextBox Text="{Binding Arguments, UpdateSourceTrigger=PropertyChanged}" />
                    <TextBlock Text="Dossier de travail (optionnel)" Style="{StaticResource FieldLabelStyle}" />
                    <TextBox Text="{Binding WorkingDirectory, UpdateSourceTrigger=PropertyChanged}" />
                </StackPanel>

                <CheckBox Content="Attendre la fin du programme" IsChecked="{Binding WaitForExit}" Margin="0,10,0,0" />
                <StackPanel Visibility="{Binding ShowsTimeout, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <TextBlock Text="Délai d'attente maximal (ms)" Style="{StaticResource FieldLabelStyle}" />
                    <TextBox Text="{Binding WaitTimeoutText, UpdateSourceTrigger=PropertyChanged}" />
                </StackPanel>
            </StackPanel>
        </DataTemplate>

        <!-- Ouvrir une URL -->
        <DataTemplate DataType="{x:Type ed:OpenUrlCommandEditorViewModel}">
            <StackPanel>
                <TextBlock Text="Adresse web ou chemin de fichier" Style="{StaticResource FieldLabelStyle}" Margin="0,0,0,4" />
                <TextBox Text="{Binding Path, UpdateSourceTrigger=PropertyChanged}" />
            </StackPanel>
        </DataTemplate>

        <!-- Fenêtre -->
        <DataTemplate DataType="{x:Type ed:WindowCommandEditorViewModel}">
            <StackPanel>
                <TextBlock Text="Action" Style="{StaticResource FieldLabelStyle}" Margin="0,0,0,4" />
                <ComboBox ItemsSource="{x:Static ed:WindowCommandEditorViewModel.ActionChoices}"
                          SelectedValuePath="Value" SelectedValue="{Binding Action}" />

                <TextBlock Text="Titre de la fenêtre (partiel)" Style="{StaticResource FieldLabelStyle}" />
                <TextBox Text="{Binding WindowTitle, UpdateSourceTrigger=PropertyChanged}" />
                <TextBlock Text="Classe Win32 (optionnelle)" Style="{StaticResource FieldLabelStyle}" />
                <TextBox Text="{Binding WindowClassName, UpdateSourceTrigger=PropertyChanged}" />

                <StackPanel Visibility="{Binding ShowsMoveResize, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <Grid Margin="0,8,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="12" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="X" Style="{StaticResource FieldLabelStyle}" />
                            <TextBox Text="{Binding XText, UpdateSourceTrigger=PropertyChanged}" />
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Y" Style="{StaticResource FieldLabelStyle}" />
                            <TextBox Text="{Binding YText, UpdateSourceTrigger=PropertyChanged}" />
                        </StackPanel>
                    </Grid>
                    <Grid Margin="0,8,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="12" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="Largeur" Style="{StaticResource FieldLabelStyle}" />
                            <TextBox Text="{Binding WidthText, UpdateSourceTrigger=PropertyChanged}" />
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Hauteur" Style="{StaticResource FieldLabelStyle}" />
                            <TextBox Text="{Binding HeightText, UpdateSourceTrigger=PropertyChanged}" />
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </StackPanel>
        </DataTemplate>

        <!-- Pixel / couleur -->
        <DataTemplate DataType="{x:Type ed:PixelCommandEditorViewModel}">
            <StackPanel>
                <TextBlock Text="Nature" Style="{StaticResource FieldLabelStyle}" Margin="0,0,0,4" />
                <ComboBox ItemsSource="{x:Static ed:PixelCommandEditorViewModel.ModeChoices}"
                          SelectedValuePath="Value" SelectedValue="{Binding Mode}" />

                <Grid Margin="0,8,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="X" Style="{StaticResource FieldLabelStyle}" />
                        <TextBox Text="{Binding XText, UpdateSourceTrigger=PropertyChanged}" />
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="Y" Style="{StaticResource FieldLabelStyle}" />
                        <TextBox Text="{Binding YText, UpdateSourceTrigger=PropertyChanged}" />
                    </StackPanel>
                </Grid>
                <TextBlock Text="Couleur attendue (#RRGGBB)" Style="{StaticResource FieldLabelStyle}" />
                <TextBox Text="{Binding ColorHex, UpdateSourceTrigger=PropertyChanged}" />
                <Button Content="Choisir à l'écran (pipette)" Command="{Binding PickColorCommand}" Margin="0,6,0,0" HorizontalAlignment="Left" />
                <TextBlock Text="Tolérance (%)" Style="{StaticResource FieldLabelStyle}" />
                <TextBox Text="{Binding ToleranceText, UpdateSourceTrigger=PropertyChanged}" />

                <StackPanel Visibility="{Binding ShowsTimeout, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <TextBlock Text="Délai d'attente maximal (ms)" Style="{StaticResource FieldLabelStyle}" />
                    <TextBox Text="{Binding TimeoutText, UpdateSourceTrigger=PropertyChanged}" />
                </StackPanel>

                <StackPanel Visibility="{Binding ShowsVariable, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <TextBlock Text="Variable recevant le résultat (1/0)" Style="{StaticResource FieldLabelStyle}" />
                    <TextBox Text="{Binding VariableName, UpdateSourceTrigger=PropertyChanged}" />
                </StackPanel>
            </StackPanel>
        </DataTemplate>

        <!-- Sons -->
        <DataTemplate DataType="{x:Type ed:SoundCommandEditorViewModel}">
            <StackPanel>
                <TextBlock Text="Fichier son (.wav)" Style="{StaticResource FieldLabelStyle}" Margin="0,0,0,4" />
                <TextBox Text="{Binding FilePath, UpdateSourceTrigger=PropertyChanged}" />
                <CheckBox Content="Attendre la fin du son" IsChecked="{Binding WaitForCompletion}" Margin="0,10,0,0" />
            </StackPanel>
        </DataTemplate>

        <!-- Message -->
        <DataTemplate DataType="{x:Type ed:MessageCommandEditorViewModel}">
            <StackPanel>
                <TextBlock Text="Titre" Style="{StaticResource FieldLabelStyle}" Margin="0,0,0,4" />
                <TextBox Text="{Binding Title, UpdateSourceTrigger=PropertyChanged}" />
                <TextBlock Text="Message (jetons {date}/{clipboard}/{var:nom} acceptés)" Style="{StaticResource FieldLabelStyle}" TextWrapping="Wrap" />
                <TextBox Text="{Binding Text, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" TextWrapping="Wrap"
                         MinHeight="70" MaxHeight="160" VerticalScrollBarVisibility="Auto" VerticalContentAlignment="Top" />
                <TextBlock Text="Nature" Style="{StaticResource FieldLabelStyle}" />
                <ComboBox ItemsSource="{x:Static ed:MessageCommandEditorViewModel.KindChoices}"
                          SelectedValuePath="Value" SelectedValue="{Binding MessageKind}" />
                <StackPanel Visibility="{Binding ShowsResultVariable, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <TextBlock Text="Variable recevant « ok »/« cancel »" Style="{StaticResource FieldLabelStyle}" />
                    <TextBox Text="{Binding ResultVariableName, UpdateSourceTrigger=PropertyChanged}" />
                </StackPanel>
            </StackPanel>
        </DataTemplate>

        <!-- Recherche d'image -->
        <DataTemplate DataType="{x:Type ed:ImageSearchCommandEditorViewModel}">
            <StackPanel>
                <TextBlock Text="{Binding TemplateSummary}" Style="{StaticResource FieldLabelStyle}" Margin="0,0,0,4" />
                <Button Content="Capturer une image" Command="{Binding CaptureRegionCommand}" HorizontalAlignment="Left" />

                <Border Visibility="{Binding HasTemplate, Converter={StaticResource BooleanToVisibilityConverter}}"
                        BorderBrush="{DynamicResource BrushBorder}" BorderThickness="1" Background="Black"
                        HorizontalAlignment="Left" Margin="0,8,0,0">
                    <Image Source="{Binding TemplatePreview}" Stretch="Uniform" MaxWidth="240" MaxHeight="180" />
                </Border>

                <TextBlock Text="Tolérance (%)" Style="{StaticResource FieldLabelStyle}" Margin="0,10,0,0" />
                <TextBox Text="{Binding ToleranceText, UpdateSourceTrigger=PropertyChanged}" />

                <TextBlock Text="Délai d'attente maximal (ms, 0 = chercher une seule fois)" Style="{StaticResource FieldLabelStyle}" TextWrapping="Wrap" />
                <TextBox Text="{Binding TimeoutText, UpdateSourceTrigger=PropertyChanged}" />

                <CheckBox Content="Cliquer si trouvée" IsChecked="{Binding ClickIfFound}" Margin="0,10,0,0" />
                <StackPanel Visibility="{Binding ShowsButton, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <TextBlock Text="Bouton" Style="{StaticResource FieldLabelStyle}" />
                    <ComboBox ItemsSource="{x:Static ed:ImageSearchCommandEditorViewModel.ButtonChoices}"
                              SelectedValuePath="Value" SelectedValue="{Binding ClickButton}" />
                    <CheckBox Content="Double-clic (ex. lancer une icône)" IsChecked="{Binding DoubleClick}" Margin="0,8,0,0" />
                </StackPanel>

                <TextBlock Text="Variable X du point trouvé (optionnelle)" Style="{StaticResource FieldLabelStyle}" Margin="0,10,0,0" />
                <TextBox Text="{Binding FoundXVariable, UpdateSourceTrigger=PropertyChanged}" />
                <TextBlock Text="Variable Y du point trouvé (optionnelle)" Style="{StaticResource FieldLabelStyle}" />
                <TextBox Text="{Binding FoundYVariable, UpdateSourceTrigger=PropertyChanged}" />

                <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                    <Button Content="Tester" Command="{Binding TestCommand}"
                            IsEnabled="{Binding IsTesting, Converter={StaticResource InverseBooleanConverter}}" />
                </StackPanel>
                <TextBlock Text="{Binding TestResultMessage}" TextWrapping="Wrap" Margin="0,8,0,0"
                           Visibility="{Binding TestResultMessage, Converter={StaticResource NullOrEmptyToVisibilityConverter}}" />
            </StackPanel>
        </DataTemplate>

        <!-- Si (condition) -->
        <DataTemplate DataType="{x:Type ed:IfCommandEditorViewModel}">
            <StackPanel>
                <TextBlock Text="Condition" Style="{StaticResource FieldLabelStyle}" Margin="0,0,0,4" />
                <ComboBox ItemsSource="{x:Static ed:IfCommandEditorViewModel.ConditionKindChoices}"
                          SelectedValuePath="Value" SelectedValue="{Binding ConditionKind}" />
                <CheckBox Content="Inverser (Sinon si)" IsChecked="{Binding Negate}" Margin="0,8,0,0" />

                <StackPanel Visibility="{Binding ShowsWindowFields, Converter={StaticResource BooleanToVisibilityConverter}}" Margin="0,10,0,0">
                    <TextBlock Text="Titre de la fenêtre (partiel)" Style="{StaticResource FieldLabelStyle}" />
                    <TextBox Text="{Binding WindowTitle, UpdateSourceTrigger=PropertyChanged}" />
                    <TextBlock Text="Classe Win32 (optionnelle)" Style="{StaticResource FieldLabelStyle}" />
                    <TextBox Text="{Binding WindowClassName, UpdateSourceTrigger=PropertyChanged}" />
                </StackPanel>

                <StackPanel Visibility="{Binding ShowsPixelFields, Converter={StaticResource BooleanToVisibilityConverter}}" Margin="0,10,0,0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="12" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="X" Style="{StaticResource FieldLabelStyle}" />
                            <TextBox Text="{Binding PixelXText, UpdateSourceTrigger=PropertyChanged}" />
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Y" Style="{StaticResource FieldLabelStyle}" />
                            <TextBox Text="{Binding PixelYText, UpdateSourceTrigger=PropertyChanged}" />
                        </StackPanel>
                    </Grid>
                    <TextBlock Text="Couleur attendue (#RRGGBB)" Style="{StaticResource FieldLabelStyle}" />
                    <TextBox Text="{Binding PixelColorHex, UpdateSourceTrigger=PropertyChanged}" />
                    <Button Content="Choisir à l'écran (pipette)" Command="{Binding PickColorCommand}" Margin="0,6,0,0" HorizontalAlignment="Left" />
                    <TextBlock Text="Tolérance (%)" Style="{StaticResource FieldLabelStyle}" />
                    <TextBox Text="{Binding PixelToleranceText, UpdateSourceTrigger=PropertyChanged}" />
                </StackPanel>

                <StackPanel Visibility="{Binding ShowsImageFields, Converter={StaticResource BooleanToVisibilityConverter}}" Margin="0,10,0,0">
                    <TextBlock Text="{Binding ImageSummary}" Style="{StaticResource FieldLabelStyle}" />
                    <Button Content="Capturer une image" Command="{Binding CaptureImageCommand}" Margin="0,4,0,0" HorizontalAlignment="Left" />
                    <TextBlock Text="Tolérance (%)" Style="{StaticResource FieldLabelStyle}" Margin="0,8,0,0" />
                    <TextBox Text="{Binding ImageToleranceText, UpdateSourceTrigger=PropertyChanged}" />
                </StackPanel>

                <StackPanel Visibility="{Binding ShowsVariableFields, Converter={StaticResource BooleanToVisibilityConverter}}" Margin="0,10,0,0">
                    <TextBlock Text="Variable" Style="{StaticResource FieldLabelStyle}" />
                    <TextBox Text="{Binding VariableName, UpdateSourceTrigger=PropertyChanged}" />
                    <TextBlock Text="Opérateur" Style="{StaticResource FieldLabelStyle}" />
                    <ComboBox ItemsSource="{x:Static ed:IfCommandEditorViewModel.ComparisonOperatorChoices}"
                              SelectedValuePath="Value" SelectedValue="{Binding ComparisonOperator}" />
                    <TextBlock Text="Valeur" Style="{StaticResource FieldLabelStyle}" />
                    <TextBox Text="{Binding ComparisonValue, UpdateSourceTrigger=PropertyChanged}" />
                </StackPanel>

                <StackPanel Visibility="{Binding ShowsFileFields, Converter={StaticResource BooleanToVisibilityConverter}}" Margin="0,10,0,0">
                    <TextBlock Text="Chemin du fichier" Style="{StaticResource FieldLabelStyle}" />
                    <TextBox Text="{Binding FilePath, UpdateSourceTrigger=PropertyChanged}" />
                </StackPanel>
            </StackPanel>
        </DataTemplate>

        <!-- Boucle -->
        <DataTemplate DataType="{x:Type ed:LoopCommandEditorViewModel}">
            <StackPanel>
                <TextBlock Text="Nature" Style="{StaticResource FieldLabelStyle}" Margin="0,0,0,4" />
                <ComboBox ItemsSource="{x:Static ed:LoopCommandEditorViewModel.ModeChoices}"
                          SelectedValuePath="Value" SelectedValue="{Binding Mode}" />

                <StackPanel Visibility="{Binding ShowsRepeatCount, Converter={StaticResource BooleanToVisibilityConverter}}" Margin="0,10,0,0">
                    <TextBlock Text="Nombre de répétitions" Style="{StaticResource FieldLabelStyle}" />
                    <TextBox Text="{Binding RepeatCountText, UpdateSourceTrigger=PropertyChanged}" />
                </StackPanel>

                <StackPanel Visibility="{Binding ShowsWhile, Converter={StaticResource BooleanToVisibilityConverter}}" Margin="0,10,0,0">
                    <TextBlock Text="Condition" Style="{StaticResource FieldLabelStyle}" />
                    <ComboBox ItemsSource="{x:Static ed:LoopCommandEditorViewModel.ConditionKindChoices}"
                              SelectedValuePath="Value" SelectedValue="{Binding ConditionKind}" />

                    <StackPanel Visibility="{Binding ShowsWindowFields, Converter={StaticResource BooleanToVisibilityConverter}}" Margin="0,8,0,0">
                        <TextBlock Text="Titre de la fenêtre (partiel)" Style="{StaticResource FieldLabelStyle}" />
                        <TextBox Text="{Binding WindowTitle, UpdateSourceTrigger=PropertyChanged}" />
                        <TextBlock Text="Classe Win32 (optionnelle)" Style="{StaticResource FieldLabelStyle}" />
                        <TextBox Text="{Binding WindowClassName, UpdateSourceTrigger=PropertyChanged}" />
                    </StackPanel>

                    <StackPanel Visibility="{Binding ShowsPixelFields, Converter={StaticResource BooleanToVisibilityConverter}}" Margin="0,8,0,0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="12" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="X" Style="{StaticResource FieldLabelStyle}" />
                                <TextBox Text="{Binding PixelXText, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Y" Style="{StaticResource FieldLabelStyle}" />
                                <TextBox Text="{Binding PixelYText, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>
                        </Grid>
                        <TextBlock Text="Couleur attendue (#RRGGBB)" Style="{StaticResource FieldLabelStyle}" />
                        <TextBox Text="{Binding PixelColorHex, UpdateSourceTrigger=PropertyChanged}" />
                        <Button Content="Choisir à l'écran (pipette)" Command="{Binding PickColorCommand}" Margin="0,6,0,0" HorizontalAlignment="Left" />
                        <TextBlock Text="Tolérance (%)" Style="{StaticResource FieldLabelStyle}" />
                        <TextBox Text="{Binding PixelToleranceText, UpdateSourceTrigger=PropertyChanged}" />
                    </StackPanel>

                    <StackPanel Visibility="{Binding ShowsImageFields, Converter={StaticResource BooleanToVisibilityConverter}}" Margin="0,8,0,0">
                        <TextBlock Text="{Binding ImageSummary}" Style="{StaticResource FieldLabelStyle}" />
                        <Button Content="Capturer une image" Command="{Binding CaptureImageCommand}" Margin="0,4,0,0" HorizontalAlignment="Left" />
                        <TextBlock Text="Tolérance (%)" Style="{StaticResource FieldLabelStyle}" Margin="0,8,0,0" />
                        <TextBox Text="{Binding ImageToleranceText, UpdateSourceTrigger=PropertyChanged}" />
                    </StackPanel>

                    <StackPanel Visibility="{Binding ShowsVariableCompareFields, Converter={StaticResource BooleanToVisibilityConverter}}" Margin="0,8,0,0">
                        <TextBlock Text="Variable" Style="{StaticResource FieldLabelStyle}" />
                        <TextBox Text="{Binding ConditionVariableName, UpdateSourceTrigger=PropertyChanged}" />
                        <TextBlock Text="Opérateur" Style="{StaticResource FieldLabelStyle}" />
                        <ComboBox ItemsSource="{x:Static ed:LoopCommandEditorViewModel.ComparisonOperatorChoices}"
                                  SelectedValuePath="Value" SelectedValue="{Binding ComparisonOperator}" />
                        <TextBlock Text="Valeur" Style="{StaticResource FieldLabelStyle}" />
                        <TextBox Text="{Binding ComparisonValue, UpdateSourceTrigger=PropertyChanged}" />
                    </StackPanel>

                    <StackPanel Visibility="{Binding ShowsFileFields, Converter={StaticResource BooleanToVisibilityConverter}}" Margin="0,8,0,0">
                        <TextBlock Text="Chemin du fichier" Style="{StaticResource FieldLabelStyle}" />
                        <TextBox Text="{Binding ConditionFilePath, UpdateSourceTrigger=PropertyChanged}" />
                    </StackPanel>
                </StackPanel>

                <StackPanel Visibility="{Binding ShowsForEachLine, Converter={StaticResource BooleanToVisibilityConverter}}" Margin="0,10,0,0">
                    <TextBlock Text="Fichier texte" Style="{StaticResource FieldLabelStyle}" />
                    <TextBox Text="{Binding LinesFilePath, UpdateSourceTrigger=PropertyChanged}" />
                    <TextBlock Text="Variable recevant chaque ligne" Style="{StaticResource FieldLabelStyle}" />
                    <TextBox Text="{Binding LineVariableName, UpdateSourceTrigger=PropertyChanged}" />
                </StackPanel>
            </StackPanel>
        </DataTemplate>

        <!-- Variable -->
        <DataTemplate DataType="{x:Type ed:VariableCommandEditorViewModel}">
            <StackPanel>
                <TextBlock Text="Action" Style="{StaticResource FieldLabelStyle}" Margin="0,0,0,4" />
                <ComboBox ItemsSource="{x:Static ed:VariableCommandEditorViewModel.ModeChoices}"
                          SelectedValuePath="Value" SelectedValue="{Binding Mode}" />
                <TextBlock Text="Nom de la variable" Style="{StaticResource FieldLabelStyle}" />
                <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" />
                <TextBlock Text="{Binding ValueHint}" Style="{StaticResource FieldLabelStyle}" TextWrapping="Wrap" />
                <TextBox Text="{Binding Value, UpdateSourceTrigger=PropertyChanged}" />
            </StackPanel>
        </DataTemplate>

        <!-- Étiquette -->
        <DataTemplate DataType="{x:Type ed:LabelCommandEditorViewModel}">
            <StackPanel>
                <TextBlock Text="Nom de l'étiquette" Style="{StaticResource FieldLabelStyle}" Margin="0,0,0,4" />
                <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" />
            </StackPanel>
        </DataTemplate>

        <!-- Aller à l'étiquette -->
        <DataTemplate DataType="{x:Type ed:GotoCommandEditorViewModel}">
            <StackPanel>
                <TextBlock Text="Étiquette cible" Style="{StaticResource FieldLabelStyle}" Margin="0,0,0,4" />
                <ComboBox ItemsSource="{Binding KnownLabels}" Text="{Binding TargetLabel, UpdateSourceTrigger=PropertyChanged}"
                          IsEditable="True">
                    <!-- Foreground forcé explicitement sur chaque élément : dans ce ComboBox éditable (le seul de
                         l'app), le texte des éléments hérite mal la couleur ambiante malgré le style ComboBoxItem
                         partagé (vérifié réellement : éléments présents et cliquables, mais invisibles). -->
                    <ComboBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding}" Foreground="{DynamicResource BrushTextPrimary}" />
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>
                <TextBlock Text="Choisissez une étiquette existante ou tapez son nom (créez-la via l'icône « Étiquette »)."
                           Style="{StaticResource FieldLabelStyle}" TextWrapping="Wrap" Margin="0,6,0,0" />
            </StackPanel>
        </DataTemplate>

        <!-- Arrêter -->
        <DataTemplate DataType="{x:Type ed:StopCommandEditorViewModel}">
            <TextBlock Text="Arrête immédiatement la lecture (relâche les touches/boutons tenus)." TextWrapping="Wrap" />
        </DataTemplate>

        <!-- Pause -->
        <DataTemplate DataType="{x:Type ed:PauseCommandEditorViewModel}">
            <StackPanel>
                <TextBlock Text="Touche : cliquez dans le champ puis appuyez sur la touche voulue (laisser « N'importe quelle touche » pour ne pas restreindre)" Style="{StaticResource FieldLabelStyle}" TextWrapping="Wrap" />
                <TextBox Tag="WaitKeyCapture" IsReadOnly="True" IsReadOnlyCaretVisible="False" Cursor="Arrow"
                         Text="{Binding KeyLabel, Mode=OneWay}" FontWeight="SemiBold" />
                <TextBlock Text="Délai d'attente maximal (ms, 0 = infini)" Style="{StaticResource FieldLabelStyle}" />
                <TextBox Text="{Binding TimeoutText, UpdateSourceTrigger=PropertyChanged}" />
            </StackPanel>
        </DataTemplate>

        <!-- Appeler une autre macro -->
        <DataTemplate DataType="{x:Type ed:CallCommandEditorViewModel}">
            <StackPanel>
                <TextBlock Text="Fichier macro (.v0xmacro)" Style="{StaticResource FieldLabelStyle}" Margin="0,0,0,4" />
                <TextBox Text="{Binding MacroFilePath, UpdateSourceTrigger=PropertyChanged}" />
                <Button Content="Parcourir…" Command="{Binding BrowseCommand}" Margin="0,6,0,0" HorizontalAlignment="Left" />
            </StackPanel>
        </DataTemplate>

        <!-- Commentaire -->
        <DataTemplate DataType="{x:Type ed:CommentCommandEditorViewModel}">
            <StackPanel>
                <TextBlock Text="Commentaire (ignoré à la lecture)" Style="{StaticResource FieldLabelStyle}" Margin="0,0,0,4" />
                <TextBox Text="{Binding Text, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" TextWrapping="Wrap"
                         MinHeight="90" MaxHeight="200" VerticalScrollBarVisibility="Auto" VerticalContentAlignment="Top" />
            </StackPanel>
        </DataTemplate>

        <!-- Script C# -->
        <DataTemplate DataType="{x:Type ed:ScriptCommandEditorViewModel}">
            <StackPanel>
                <TextBlock Text="Code C# — API disponible : Mouse, Keyboard, Window, Clipboard, Vars, Log"
                           Style="{StaticResource FieldLabelStyle}" TextWrapping="Wrap" Margin="0,0,0,4" />
                <Border BorderBrush="{DynamicResource BrushBorder}" BorderThickness="1">
                    <avalonEdit:TextEditor FontFamily="Consolas" FontSize="13" Height="220"
                                            ShowLineNumbers="True" WordWrap="False"
                                            HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto"
                                            helpers:AvalonEditBehavior.BoundText="{Binding Code, Mode=TwoWay}"
                                            Loaded="ScriptEditor_Loaded" />
                </Border>

                <TextBlock Text="Délai d'exécution maximal (secondes)" Style="{StaticResource FieldLabelStyle}" Margin="0,10,0,0" />
                <TextBox Text="{Binding TimeoutText, UpdateSourceTrigger=PropertyChanged}" />

                <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                    <Button Content="Tester" Command="{Binding TestCommand}"
                            IsEnabled="{Binding IsTesting, Converter={StaticResource InverseBooleanConverter}}" />
                </StackPanel>
                <TextBlock Text="{Binding TestResultMessage}" TextWrapping="Wrap" Margin="0,8,0,0"
                           Visibility="{Binding TestResultMessage, Converter={StaticResource NullOrEmptyToVisibilityConverter}}" />

                <TextBlock Margin="0,10,0,0" TextWrapping="Wrap" FontSize="11" Foreground="{DynamicResource BrushWarning}"
                           Text="Sécurité : ce script s'exécute réellement (souris, clavier, fenêtres…), aussi bien avec « Tester » qu'à la lecture. Ne l'exécutez que si vous en faites confiance le contenu ; il n'est jamais exécuté à la simple ouverture d'un fichier macro." />
            </StackPanel>
        </DataTemplate>

        <!-- Saisie protégée -->
        <DataTemplate DataType="{x:Type ed:SecureInputCommandEditorViewModel}">
            <StackPanel>
                <RadioButton Content="Demander le secret à chaque lecture (recommandé, jamais rien d'enregistré)"
                             GroupName="SecureInputMode" IsChecked="{Binding PromptAtPlayback}" />
                <RadioButton Content="Enregistrer un secret chiffré (cet ordinateur et ce compte Windows uniquement)"
                             GroupName="SecureInputMode" Margin="0,4,0,0"
                             IsChecked="{Binding PromptAtPlayback, Converter={StaticResource InverseBooleanConverter}}" />

                <StackPanel Margin="0,10,0,0" Visibility="{Binding PromptAtPlayback, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <TextBlock Text="Libellé affiché par l'invite à la lecture" Style="{StaticResource FieldLabelStyle}" />
                    <TextBox Text="{Binding PromptLabel, UpdateSourceTrigger=PropertyChanged}" />
                </StackPanel>

                <StackPanel Margin="0,10,0,0" Visibility="{Binding PromptAtPlayback, Converter={StaticResource InverseBooleanToVisibilityConverter}}">
                    <TextBlock Text="Secret" Style="{StaticResource FieldLabelStyle}" />
                    <PasswordBox Tag="SecureInputSecret" FontFamily="Consolas" PasswordChanged="SecureInputSecretBox_PasswordChanged" />
                    <TextBlock Text="Un secret est déjà enregistré : laissez ce champ vide pour le conserver, ou saisissez-en un nouveau pour le remplacer."
                               FontSize="11" Opacity="0.8" TextWrapping="Wrap" Margin="0,4,0,0"
                               Visibility="{Binding HasStoredSecret, Converter={StaticResource BooleanToVisibilityConverter}}" />
                </StackPanel>

                <TextBlock Text="Délai entre deux caractères (ms)" Style="{StaticResource FieldLabelStyle}" Margin="0,10,0,0" />
                <TextBox Text="{Binding CharacterDelayText, UpdateSourceTrigger=PropertyChanged}" />

                <TextBlock Margin="0,10,0,0" TextWrapping="Wrap" FontSize="11" Foreground="{DynamicResource BrushWarning}"
                           Text="Sécurité : le secret est saisi comme du texte normal (visible à l'écran pendant la lecture, comme n'importe quel mot de passe tapé au clavier). Le mode « enregistrer » chiffre le secret pour cet ordinateur et ce compte Windows uniquement : une macro copiée ailleurs ne pourra pas le déchiffrer." />
            </StackPanel>
        </DataTemplate>
    </Window.Resources>

    <StackPanel Margin="20">
        <ContentControl Content="{Binding}" />

        <StackPanel Visibility="{Binding ShowsDelay, Converter={StaticResource BooleanToVisibilityConverter}}">
            <TextBlock Text="Délai avant la commande (ms)" Style="{StaticResource FieldLabelStyle}" />
            <TextBox Text="{Binding DelayText, UpdateSourceTrigger=PropertyChanged}" />
        </StackPanel>

        <TextBlock Text="Vérifiez les valeurs saisies : des nombres entiers sont attendus." Margin="0,12,0,0"
                   Foreground="{DynamicResource BrushWarning}" TextWrapping="Wrap"
                   Visibility="{Binding IsValid, Converter={StaticResource InverseBooleanToVisibilityConverter}}" />

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
            <Button Content="OK" IsDefault="True" MinWidth="90" Style="{StaticResource PrimaryButtonStyle}"
                    IsEnabled="{Binding IsValid}" Click="OkButton_Click" />
            <Button Content="Annuler" IsCancel="True" MinWidth="90" Margin="8,0,0,0" />
        </StackPanel>
    </StackPanel>
</Window>
